# Copy to .env locally. Fill secrets on your machine; never paste them into chat.
POSTGRES_DB=sales_agent
POSTGRES_USER=sales_agent
POSTGRES_PASSWORD=sales_agent_demo_password
DATABASE_URL=postgresql+asyncpg://sales_agent:sales_agent_demo_password@db:5432/sales_agent

DEMO_MODE=true
AI_PROVIDER=stub
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# Alibaba Cloud Model Studio embeddings and optional reranking.
BAILIAN_API_KEY=
BAILIAN_API_HOST=
BAILIAN_EMBEDDING_MODEL=qwen3.7-text-embedding
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_RERANK_MODEL=qwen3-rerank
RAG_ENABLED=false
RAG_INDEX_PATH=runtime/rag_history/email_rag_index.json
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.25

# Optional company research for explicit product-list requests with no unique
# CRM/Excel product interest. Enable research first in observation mode; enable
# autonomous use only after reviewing the recorded evidence and results.
COMPANY_RESEARCH_ENABLED=false
COMPANY_RESEARCH_AUTO_SEND_ENABLED=false
COMPANY_RESEARCH_CACHE_DAYS=90
COMPANY_RESEARCH_MAX_SEARCHES=2
COMPANY_RESEARCH_MIN_SOURCES=2
COMPANY_RESEARCH_MIN_IDENTITY_CONFIDENCE=0.90
COMPANY_RESEARCH_MIN_CATEGORY_CONFIDENCE=0.85
COMPANY_RESEARCH_MIN_SCORE_GAP=0.15

MAIL_TRANSPORT=file
MAIL_FROM=sales-agent@example.com
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SYNC_ENABLED=false
IMAP_FOLDER=INBOX
IMAP_SENT_FOLDER=[Gmail]/Sent Mail
IMAP_POLL_SECONDS=60
IMAP_BATCH_SIZE=50
IMAP_DAILY_DOWNLOAD_LIMIT_MB=1500
IMAP_MAX_BACKOFF_SECONDS=1800
JOB_LEASE_SECONDS=900
OUTBOX_LEASE_SECONDS=600
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_STARTTLS=false

# One-time, read-only recovery of Foxmail historical exports. These credentials
# are deliberately separate from the live sales mailbox settings above.
RAG_IMAP_ADDRESS=
RAG_IMAP_APP_PASSWORD=
RAG_IMAP_HOST=imap.gmail.com
RAG_IMAP_PORT=993
RAG_IMAP_FOLDER=[Gmail]/All Mail
RAG_IMAP_MAX_DOWNLOAD_MB=2048

DINGTALK_TRANSPORT=log
DINGTALK_WEBHOOK_URL=

# Weekly commercial-data gate. Nanjing staff confirm prices and per-product
# inventory for the China-local commercial week before automated quotes send.
COMMERCIAL_GATE_ENABLED=true
COMMERCIAL_DATA_PROVIDER=database
COMMERCIAL_SCOPE=default
COMMERCIAL_TIMEZONE=Asia/Shanghai
COMMERCIAL_OPEN_HOUR=9
# Customer-facing automation and reactivation continue on India business time.
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_OPEN_HOUR=9
COMMERCIAL_REFRESH_CHECK_SECONDS=60
COMMERCIAL_RETRY_MINUTES=15
# Optional future CRM/WMS links. Leave blank to use this application's pages.
COMMERCIAL_UPDATE_URL=
CRM_REVIEW_URL_TEMPLATE=

# Historical-customer reactivation is inert until an administrator creates a
# campaign, selects recipients, and starts it from /admin/reactivation.
REACTIVATION_ENABLED=true
REACTIVATION_CHECK_SECONDS=10
# This is a dedicated cap inside the mailbox-wide hourly/daily limits below.
# Keeping it low reserves capacity for live customer replies.
REACTIVATION_MAX_SENDS_PER_DAY=5
REACTIVATION_DEFAULT_INACTIVE_DAYS=365
REACTIVATION_DEFAULT_SECOND_DAYS=90

SAFE_MODE=true
AUTO_SEND_ENABLED=false
RECIPIENT_ALLOWLIST=internal@example.com
MAX_SENDS_PER_HOUR=5
MAX_SENDS_PER_DAY=20
MIN_SEND_INTERVAL_SECONDS=120
SEND_INTERVAL_JITTER_SECONDS=180
GMAIL_TRANSIENT_COOLDOWN_SECONDS=600
GMAIL_DAILY_COOLDOWN_SECONDS=86400
EMAIL_PREFLIGHT_ENABLED=true
MX_CHECK_ENABLED=true
MX_CACHE_TTL_HOURS=168
MX_LOOKUP_TIMEOUT_SECONDS=5
MX_TEMPORARY_RETRY_MINUTES=30

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-locally
PUBLIC_BASE_URL=http://localhost:8000
RUNTIME_DIR=/app/runtime
CONTENT_DIR=/app/config/content

# NAS knowledge indexing. Keep disabled until the read-only bind mount has been
# verified. On Windows Docker Desktop, use //server/share syntax for the host
# path and grant Docker Desktop access to that network share.
NAS_KNOWLEDGE_ENABLED=false
NAS_KNOWLEDGE_HOST_DIR=./runtime/nas_mount
NAS_KNOWLEDGE_ROOT=/mnt/lanyachem
NAS_KNOWLEDGE_POLICY_PATH=/app/config/nas_knowledge_policy.yaml
NAS_KNOWLEDGE_OUTPUT_DIR=/app/runtime/nas_knowledge
NAS_KNOWLEDGE_POLL_SECONDS=300
NAS_KNOWLEDGE_MAX_FILE_MB=50
NAS_KNOWLEDGE_FILE_TIMEOUT_SECONDS=5
COA_CATALOG_ENABLED=false
COA_CATALOG_ROOT=/mnt/lanyachem/!PRODUCT DATA/!PRODUCT DOCS
COA_CATALOG_PATH=/app/runtime/coa_catalog/catalog.json
COA_PRODUCT_CATALOG_PATH=/app/config/product_catalog.yaml
COA_CATALOG_POLL_SECONDS=300
COA_CATALOG_MAX_FILE_MB=50
COA_CATALOG_FILE_TIMEOUT_SECONDS=15
COA_AUTO_SEND_ENABLED=false
PRODUCT_LIST_AUTO_SEND_ENABLED=false
QUOTE_AUTO_SEND_ENABLED=false
INBOUND_DISPOSITION_ENABLED=true
INBOUND_DISPOSITION_AI_ENABLED=true
INBOUND_DISPOSITION_AI_MIN_CONFIDENCE=0.80
INBOUND_DISPOSITION_AI_BATCH_ENABLED=true
INBOUND_DISPOSITION_AI_MAX_BATCH=250
INBOUND_DISPOSITION_AI_BATCH_POLL_SECONDS=20
INBOUND_DISPOSITION_AI_BATCH_MAX_ATTEMPTS=3
INBOUND_DISPOSITION_APPLY_ENABLED=false
REFERRAL_AUTO_CONTACT_ENABLED=false
